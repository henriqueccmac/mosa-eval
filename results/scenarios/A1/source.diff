+@register_latent("mean")
+class MeanLatentSpace(BaseLatentSpace):
+    """Average projected embeddings over observed views only."""
+
+    def _build(self) -> None:
+        self.projections = nn.ModuleDict({
+            name: nn.Linear(dim, self.latent_dim)
+            for name, dim in self.view_dims.items()
+        })
+        self.fc_mu = nn.Linear(self.latent_dim, self.latent_dim)
+        self.fc_logvar = nn.Linear(self.latent_dim, self.latent_dim)
+
+    def forward(self, view_embeddings, view_order, sample_masks=None):
+        embeddings = torch.stack([
+            self.projections[name](view_embeddings[name]) for name in view_order
+        ])
+        weights = torch.ones_like(embeddings[:, :, :1])
+        if sample_masks is not None:
+            weights = torch.stack([
+                sample_masks[name].to(embeddings.dtype) for name in view_order
+            ]).unsqueeze(-1)
+        pooled = (embeddings * weights).sum(0) / weights.sum(0).clamp_min(1)
+        mu, logvar = self.fc_mu(pooled), self.fc_logvar(pooled)
+        return mu, logvar, self.reparameterize(mu, logvar)
