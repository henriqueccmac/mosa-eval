+class ResidualMLPEncoder(OmicEncoder):
+    """An MLP encoder with a learned input-to-embedding skip path."""
+
+    def __init__(self, input_dim, hidden_dims, latent_dim, dropout_p=0.1,
+                 view_dropout_p=0.0, use_batch_norm=True, output_activation=nn.PReLU):
+        super().__init__(input_dim, hidden_dims, latent_dim, dropout_p,
+                         view_dropout_p, use_batch_norm, output_activation)
+        self.skip = nn.Linear(input_dim, latent_dim, bias=False)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        # Apply view dropout once to both paths.
+        if self.view_dropout is not None:
+            x = self.view_dropout(x)
+        return self.net(x) + self.skip(x)
