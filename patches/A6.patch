+def _fit_robust_scaling(X: np.ndarray, masks: np.ndarray) -> dict[str, np.ndarray]:
+    """Fit feature medians and IQRs on observed training entries only."""
+    median = np.zeros(X.shape[1], dtype=np.float32)
+    scale = np.ones(X.shape[1], dtype=np.float32)
+    for col in range(X.shape[1]):
+        observed = X[masks[:, col] & np.isfinite(X[:, col]), col]
+        if observed.size:
+            median[col] = np.median(observed)
+            q25, q75 = np.percentile(observed, [25, 75])
+            iqr = q75 - q25
+            if np.isfinite(iqr) and iqr > 0:
+                scale[col] = iqr
+    return {"mean": median, "scale": scale}
 
 
